{
  "name": "bolso",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Controle financeiro local-first. Os dados ficam no navegador de quem usa.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinuaxY/bolso.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "cobertura": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verificar": "npm run lint && npm run typecheck && npm run cobertura"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
